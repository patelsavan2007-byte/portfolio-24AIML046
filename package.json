{
  "name": "myportfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w frontend\"",
    "dev:client": "npm run dev -w frontend",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend && npm run lint -w server",
    "start:server": "npm run start -w server",
    "test": "npm run test -w server",
    "preview": "npm run preview -w frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.1.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.12",
    "node-cache": "^5.1.2",
    "openai": "^7.43.0"
  }
}
