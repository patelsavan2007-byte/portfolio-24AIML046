{
  "name": "myportfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w frontend\"",
    "dev:client": "npm run dev -w frontend",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w frontend",
    "lint": "npm run lint -w frontend && npm run lint -w server",
    "start:server": "npm run start -w server",
    "test": "npm run test -w server",
    "preview": "npm run preview -w frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3"
  }
}
