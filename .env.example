# ==========================================
# Application Environment Configuration
# Copy this file to .env and replace placeholder values.
# NEVER commit the real .env file with private credentials.
# ==========================================

# Server Configuration (Use 5001 if port 5000 is occupied by another project)
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5001/api

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskdb?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Practical 13: AI Service Configuration (Use either Gemini or OpenAI)
# Gemini: gemini-1.5-flash (via native fetch)
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI: gpt-4o-mini (Server-side only, NEVER exposed to client)
OPENAI_API_KEY=your_openai_api_key_here
