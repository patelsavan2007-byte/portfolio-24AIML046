# ==========================================
# Application Environment Configuration
# Copy this file to .env and replace placeholder values.
# NEVER commit the real .env file with private credentials.
# ==========================================

# Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/taskdb?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Practical 13: AI Service Configuration
# Model: gpt-4o-mini (Server-side only, NEVER exposed to client)
OPENAI_API_KEY=your_openai_api_key_here
